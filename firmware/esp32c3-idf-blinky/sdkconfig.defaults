# ESP32-C3 IDF blinky defaults for Ohmforge co-sim (ESP-IDF v5.3.2).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_UART_TX_GPIO=21
CONFIG_ESP_CONSOLE_UART_RX_GPIO=20
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# PMS / memprot needs unmodelled registers; leave it off for the simulator.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
# Keep the image small and free of Wi-Fi / Bluetooth bring-up.
CONFIG_BT_ENABLED=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT=n
